    {
      "name": "3. Inicio de sesión de administrador",
      "item": [
        {
          "name": "GET /admin/login (obtiene token CSRF)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', () => pm.response.to.have.status(200));",
                  "const m = pm.response.text().match(/name=\"_csrf\" value=\"([0-9a-f]+)\"/);",
                  "pm.test('Token CSRF presente', () => pm.expect(m).to.not.be.null);",
                  "if (m) pm.collectionVariables.set('csrf', m[1]);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /admin/login → 302 al dashboard",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "login"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "_csrf",
                  "value": "{{csrf}}"
                },
                {
                  "key": "email",
                  "value": "{{adminEmail}}"
                },
                {
                  "key": "password",
                  "value": "{{adminPassword}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 302', () => pm.response.to.have.status(302));",
                  "pm.test('Redirige al dashboard', () => pm.expect(pm.response.headers.get('Location')).to.eql('/admin/dashboard'));"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        }
      ]
    },
