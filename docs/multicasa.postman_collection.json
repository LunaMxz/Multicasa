{
  "info": {
    "name": "Multicasa API REST",
    "description": "Colección de pruebas de la API de Multicasa (Michelle). Ejecutar en orden con el Collection Runner. Variables: baseUrl (por defecto http://localhost:3000), adminEmail, adminPassword. Las rutas protegidas usan la sesión (cookie) del administrador: Postman la guarda solo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "adminEmail",
      "value": "admin@multicasa.com"
    },
    {
      "key": "adminPassword",
      "value": "Admin123!"
    },
    {
      "key": "csrf",
      "value": ""
    },
    {
      "key": "casaId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Públicas (sin sesión)",
      "item": [
        {
          "name": "GET /api/casas → 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/casas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "casas"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Estructura {total,pagina,totalPaginas,resultados}', () => { pm.expect(j).to.have.all.keys('total','pagina','totalPaginas','resultados'); });",
                  "pm.test('Solo casas en venta', () => j.resultados.forEach(c => pm.expect(c.estatus).to.eql('venta')));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/casas?q=Saltillo&precioMax=3000000 → 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/casas?q=Saltillo&precioMax=3000000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "casas"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "Saltillo"
                },
                {
                  "key": "precioMax",
                  "value": "3000000"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/casas/999999 → 404",
          "request": {
            "method": "GET",
            "header": [],
