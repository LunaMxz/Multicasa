<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11.1.14/swiper-bundle.min.css">

<section class="space-y-6">

  <!-- Carrusel principal -->
  <div class="swiper relative h-64 overflow-hidden rounded-lg shadow-md sm:h-80 lg:h-96">
    <div class="swiper-wrapper">
      <% slides.forEach((s) => { %>
        <a href="<%= s.href %>" class="swiper-slide relative block">
          <img
            src="<%= s.src %>"
            alt="<%= s.titulo %>"
            class="h-full w-full object-cover"
          >
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>
          <div class="absolute bottom-10 left-5 right-5 text-white sm:left-10">
            <p class="mb-2 text-xs font-semibold uppercase tracking-widest text-white/80">
              Bienes Raíces Multicasa
            </p>
            <h2 class="text-2xl font-bold sm:text-4xl">
              <%= s.titulo %>
            </h2>
            <span class="mt-3 inline-block rounded bg-accent px-5 py-2 text-sm font-semibold text-white">
              Conoce más
            </span>
          </div>
        </a>
      <% }) %>
    </div>
    <div class="swiper-pagination"></div>
  </div>

  <!-- Bienvenida -->
  <div class="py-4 text-center">
    <p class="text-xs font-bold uppercase tracking-widest text-brand">
      Encuentra tu próximo hogar
    </p>
    <h1 class="mt-2 text-2xl font-extrabold text-accent sm:text-3xl">
      BIENVENIDO A MULTICASA
    </h1>
    <p class="mx-auto mt-3 max-w-2xl text-sm leading-relaxed text-slate-600">
      Te acompañamos en cada paso para encontrar la propiedad que buscas.
      Descubre nuestras opciones y conoce los servicios que tenemos para ti.
    </p>
    <a href="/casas" class="btn mt-5">
      Explorar propiedades
    </a>
  </div>

  <!-- Presentación -->
  <div class="grid items-center gap-5 rounded-lg bg-slate-50 p-5 sm:grid-cols-[120px_1fr]">
    <div class="flex justify-center">
      <img
        src="/img/icono_fotos.png"
        alt="Propiedades Multicasa"
        class="h-24 w-auto object-contain"
      >
    </div>
    <div>
      <h2 class="text-lg font-bold text-brand-dark">
        Tu próximo proyecto comienza aquí
      </h2>
      <p class="mt-2 text-sm leading-relaxed text-slate-600">
        En Bienes Raíces Multicasa ponemos a tu alcance alternativas
        inmobiliarias y servicios para ayudarte a tomar una decisión
        informada. Explora nuestro catálogo y encuentra una opción
        que se adapte a tus necesidades.
      </p>
    </div>
  </div>

  <!-- Propiedades -->
  <section>
    <div class="mb-4 flex items-center justify-between border-b-2 border-brand pb-2">
      <h2 class="text-lg font-bold uppercase text-brand-dark">
        Propiedades destacadas
      </h2>
      <a href="/casas" class="text-xs font-semibold text-brand hover:underline">
        Ver todas
      </a>
    </div>

    <% if (destacadas.length) { %>
      <div class="grid gap-5 sm:grid-cols-2">
        <% destacadas.forEach((casa) => { %>
          <%- include('../partials/casa-card', { casa }) %>
        <% }) %>
      </div>
    <% } else { %>
      <div class="rounded-lg border border-dashed border-slate-300 bg-slate-50 p-8 text-center">
        <p class="font-semibold text-slate-600">
          Próximamente encontrarás aquí nuestras propiedades.
        </p>
        <p class="mt-2 text-sm text-slate-500">
          Consulta nuestro catálogo para conocer las opciones disponibles.
        </p>
        <a href="/casas" class="btn mt-4">Consultar propiedades</a>
      </div>
    <% } %>
  </section>

</section>

<script src="https://cdn.jsdelivr.net/npm/swiper@11.1.14/swiper-bundle.min.js"></script>
<script>
  new Swiper('.swiper', {
    loop: document.querySelectorAll('.swiper-slide').length > 1,
    autoplay: {
      delay: 4500,
      disableOnInteraction: false
    },
    pagination: {
      el: '.swiper-pagination',
      clickable: true
    },
    keyboard: {
      enabled: true
    }
  });
</script>