<h1 class="titulo-seccion">Video y consejos</h1>
<p class="mb-3 text-sm text-slate-600">Conoce el objetivo de Multicasa, nuestras promociones y consejos para comprar tu casa.</p>

<%# Coloca el video (2 a 4 minutos) en public/media/multicasa.mp4 y el audio en public/media/consejos.mp3 %>
<video controls preload="metadata" class="w-full rounded bg-black" poster="/img/hero_casa.png">
  <source src="/media/multicasa.mp4" type="video/mp4">
  Tu navegador no soporta video HTML5.
</video>

<h2 class="titulo-seccion mt-6">Consejos en audio</h2>
<audio controls preload="none" class="w-full">
  <source src="/media/consejos.mp3" type="audio/mpeg">
  Tu navegador no soporta audio HTML5.
</audio>
