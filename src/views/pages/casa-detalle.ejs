<%
  const imgs = casa.imagenes || [];
  const principal = casa.imagenPrincipal();
  const numeroCasa = String(casa.id).padStart(2, '0');
  const fotoPredeterminada = '/img/casas/predeterminadas/casa-' + numeroCasa + '.jpg';
%>
<a href="/casas" class="text-xs text-brand hover:underline">&larr; Volver a la búsqueda</a>
<h1 class="mt-2 text-2xl font-bold text-brand-dark"><%= casa.titulo %></h1>
<p class="text-2xl font-bold text-accent"><%= moneda(casa.precio) %>
  <% if (casa.estatus === 'vendida') { %><span class="ml-2 rounded bg-red-600 px-2 py-0.5 align-middle text-xs text-white">VENDIDA</span><% } %>
</p>

<%# TODO(PSD): galería de imágenes de la vivienda %>
<div class="mt-4 grid gap-3 md:grid-cols-[2fr_1fr]">
  <img src="<%= principal ? principal.ruta : fotoPredeterminada %>" alt="<%= casa.titulo %>" class="h-72 w-full rounded object-cover">
  <div class="grid grid-cols-3 gap-2 md:grid-cols-2">
    <% imgs.slice(0, 6).forEach((i) => { %>
      <a href="<%= i.ruta %>" target="_blank"><img src="<%= i.miniatura %>" alt="" loading="lazy" class="h-20 w-full rounded object-cover"></a>
    <% }) %>
  </div>
</div>

<dl class="mt-4 grid grid-cols-2 gap-2 text-sm sm:grid-cols-4">
  <div class="rounded bg-slate-50 p-2"><dt class="text-xs text-slate-500">Recámaras</dt><dd class="font-bold"><%= casa.recamaras %></dd></div>
  <div class="rounded bg-slate-50 p-2"><dt class="text-xs text-slate-500">Baños</dt><dd class="font-bold"><%= casa.banos %></dd></div>
  <div class="rounded bg-slate-50 p-2"><dt class="text-xs text-slate-500">Ciudad</dt><dd class="font-bold"><%= casa.ciudad %>, <%= casa.estado %></dd></div>
  <div class="rounded bg-slate-50 p-2"><dt class="text-xs text-slate-500">C.P.</dt><dd class="font-bold"><%= casa.cp || '-' %></dd></div>
</dl>

<% if (casa.descripcion) { %><p class="mt-4 whitespace-pre-line text-sm leading-relaxed text-slate-600"><%= casa.descripcion %></p><% } %>
<% if (casa.direccion) { %><p class="mt-2 text-sm"><strong>Dirección:</strong> <%= casa.direccion %></p><% } %>

<div class="mt-4 flex flex-wrap gap-2">
  <a href="/casas/<%= casa.id %>/ficha.pdf" target="_blank" class="btn">Descargar ficha técnica (PDF)</a>
  <a href="/contacto" class="btn-secundario">Me interesa</a>
</div>

<% if (casa.latitud && casa.longitud) { %>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">

  <div
    id="mapa"
    class="mt-6 h-64 w-full rounded border"
    data-latitud="<%= Number(casa.latitud) %>"
    data-longitud="<%= Number(casa.longitud) %>"
    data-titulo="<%= casa.titulo %>">
  </div>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <script>
    const elementoMapa = document.getElementById('mapa');

    const pos = [
      Number(elementoMapa.dataset.latitud),
      Number(elementoMapa.dataset.longitud)
    ];

    const tituloCasa = elementoMapa.dataset.titulo;

    const mapa = L.map('mapa').setView(pos, 15);

    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; OpenStreetMap'
    }).addTo(mapa);

    L.marker(pos).addTo(mapa).bindPopup(tituloCasa);
  </script>
<% } %>