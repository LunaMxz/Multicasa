<div class="mx-auto mt-10 max-w-sm rounded bg-white p-6 shadow">
  <h1 class="mb-4 text-lg font-bold text-brand-dark">Acceso para administradores</h1>
  <form action="/admin/login" method="post" class="space-y-3">
    <div><label class="label" for="email">Correo</label><input class="input" id="email" name="email" type="email" required autofocus></div>
    <div><label class="label" for="password">Contraseña</label><input class="input" id="password" name="password" type="password" required></div>
    <button class="btn w-full">Entrar</button>
  </form>
</div>
