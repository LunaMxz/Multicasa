
<%
const moneda = (valor) => new Intl.NumberFormat('es-MX', {
  style: 'currency',
  currency: 'MXN',
  maximumFractionDigits: 0
}).format(Number(valor) || 0);

const porcentaje = (valor) =>
  `${Number(valor || 0).toFixed(1)}%`;
%>

<style>
  .mc-dashboard {
    --mc-blue: #153f68;
    --mc-blue-light: #205f94;
    --mc-orange: #ea861d;
    --mc-bg: #f2f6fb;
    color: #19324c;
    font-family: inherit;
  }
  .mc-heading {
    font-size: 1.65rem;
    font-weight: 800;
    color: #153f68;
    letter-spacing: -.035em;
  }
  .mc-muted { color: #75849a; }
  .mc-panel {
    background: #fff;
    border: 1px solid #e5ecf4;
    border-radius: 16px;
    box-shadow: 0 3px 14px rgba(20,55,90,.035);
    overflow: hidden;
  }
  .mc-stat {
    padding: 21px;
    position: relative;
    min-height: 130px;
  }
  .mc-stat-label {
    font-size: 12px;
    font-weight: 600;
    color: #74849a;
  }
  .mc-stat-value {
    font-size: clamp(1.35rem,2vw,1.8rem);
    font-weight: 800;
    margin-top: 10px;
    letter-spacing: -.04em;
    line-height: 1.2;
  }
  .mc-stat-icon {
    width: 40px;
    height: 40px;
    border-radius: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    background: #ebf3fc;
    color: #205f94;
  }
  .mc-section-title {
    font-size: 15px;
    font-weight: 800;
    color: #193e65;
  }
  .mc-panel-header {
    padding: 20px 22px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .mc-pill {
    font-size: 11px;
    padding: 5px 10px;
    border-radius: 50px;
    font-weight: 700;
  }
  .mc-pill-green {
    background: #e6f5ed;
    color: #18835a;
  }
  .mc-pill-orange {
    background: #fff1df;
    color: #b96a10;
  }
  .mc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: 9px;
    padding: 10px 15px;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: .15s ease;
  }
  .mc-btn:hover {
    filter: brightness(.95);
    transform: translateY(-1px);
  }
  .mc-btn-primary {
    background: #205f94;
    color: white;
  }
  .mc-btn-orange {
    background: #ea861d;
    color: white;
  }
  .mc-btn-secondary {
    background: white;
    color: #205f94;
    border: 1px solid #d9e3ef;
  }
  .mc-field {
    background: #fff;
    border: 1px solid #dbe5ef;
    border-radius: 9px;
    padding: 10px 12px;
    font-size: 12px;
    outline: none;
    min-width: 0;
  }
  .mc-field:focus {
    border-color: #205f94;
    box-shadow: 0 0 0 3px rgba(32,95,148,.1);
  }
  .mc-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
  }
  .mc-table th {
    color: #75859a;
    background: #f6f9fc;
    text-transform: uppercase;
    font-size: 10px;
    letter-spacing: .05em;
    text-align: left;
    padding: 14px 17px;
    white-space: nowrap;
  }
  .mc-table td {
    padding: 14px 17px;
    border-top: 1px solid #eef2f7;
    vertical-align: middle;
  }
  .mc-table tbody tr:hover { background: #f8fbff; }
  .mc-chart-box {
    padding: 0 18px 20px;
    height: 275px;
    position: relative;
  }
  .mc-chart-box canvas {
    width: 100% !important;
    height: 100% !important;
  }
  #mcMapa {
    height: 330px;
    width: 100%;
    z-index: 0;
    background: #e9eff5;
  }
  .mc-map-popup {
    font-family: inherit;
    min-width: 150px;
  }
  .mc-empty {
    text-align: center;
    padding: 32px 16px;
    color: #74849a;
  }
  .mc-footer {
    font-size: 11px;
    color: #8c9aab;
    text-align: center;
    padding: 16px 0;
  }
  @media (max-width: 640px) {
    .mc-panel-header { padding: 16px; }
    .mc-chart-box { height: 245px; }
    .mc-stat { padding: 16px; min-height: 112px; }
    #mcMapa { height: 290px; }
  }
</style>

<div class="mc-dashboard mx-auto max-w-7xl pb-8">

  <!-- Encabezado -->
  <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
    <div>
      <p class="mb-1 text-xs font-semibold uppercase tracking-widest text-slate-400">
        Panel de administración
      </p>
      <h1 class="mc-heading">Resumen inmobiliario</h1>
      <p class="mc-muted mt-1 text-sm">
        Consulta las propiedades, estadísticas y ubicaciones de Multicasa.
      </p>
    </div>

    <div class="flex flex-wrap gap-2">
      <button id="mcActualizar" type="button" class="mc-btn mc-btn-secondary">
        ↻ Actualizar
      </button>

    </div>
  </div>

  <!-- Indicadores -->
  <div class="mb-5 grid grid-cols-2 gap-3 lg:grid-cols-3 xl:grid-cols-6">

    <div class="mc-panel mc-stat">
      <div class="flex items-start justify-between gap-2">
        <span class="mc-stat-label">Total de casas</span>
        <span class="mc-stat-icon">⌂</span>
      </div>
      <div class="mc-stat-value text-blue-900"><%= total %></div>
      <p class="mt-2 text-xs text-slate-400">Registradas</p>
    </div>

    <div class="mc-panel mc-stat">
      <div class="flex items-start justify-between gap-2">
        <span class="mc-stat-label">En venta</span>
        <span class="mc-stat-icon" style="background:#e6f5ed;color:#18835a">✓</span>
      </div>
      <div class="mc-stat-value" style="color:#18835a">
        <%= resumen.enVenta %>
      </div>
      <p class="mt-2 text-xs text-slate-400">Disponibles</p>
    </div>

    <div class="mc-panel mc-stat">
      <div class="flex items-start justify-between gap-2">
        <span class="mc-stat-label">Vendidas</span>
        <span class="mc-stat-icon" style="background:#fff1df;color:#ea861d">★</span>
      </div>
      <div class="mc-stat-value" style="color:#ea861d">
        <%= resumen.vendidas %>
      </div>
      <p class="mt-2 text-xs text-slate-400">Registradas como vendidas</p>
    </div>

    <div class="mc-panel mc-stat">
      <div class="flex items-start justify-between gap-2">
        <span class="mc-stat-label">Inventario disponible</span>
        <span class="mc-stat-icon">$</span>
      </div>
      <div class="mc-stat-value text-blue-900">
        <%= moneda(resumen.valorInventario) %>
      </div>
      <p class="mt-2 text-xs text-slate-400">Valor de casas en venta</p>
    </div>

    <div class="mc-panel mc-stat">
      <div class="flex items-start justify-between gap-2">
        <span class="mc-stat-label">Precio promedio</span>
        <span class="mc-stat-icon">↗</span>
      </div>
      <div class="mc-stat-value text-blue-900">
        <%= moneda(resumen.precioPromedio) %>
      </div>
      <p class="mt-2 text-xs text-slate-400">Todas las propiedades</p>
    </div>

    <div class="mc-panel mc-stat">
      <div class="flex items-start justify-between gap-2">
        <span class="mc-stat-label">Porcentaje vendido</span>
        <span class="mc-stat-icon" style="background:#f2ebff;color:#8057bb">%</span>
      </div>
      <div class="mc-stat-value text-blue-900">
        <%= porcentaje(resumen.porcentajeVendido) %>
      </div>
      <div class="mt-3 h-2 overflow-hidden rounded-full bg-slate-100">
        <div
          id="barraPorcentajeVendido"
          class="h-full rounded-full"
          style="background-color: #ea861d;"
          data-porcentaje="<%= resumen.porcentajeVendido %>">
        </div>
      </div>
    </div>

  </div>

  <!-- Gráficas principales -->
  <div class="mb-5 grid gap-4 lg:grid-cols-2">

    <section class="mc-panel">
      <div class="mc-panel-header">
        <div>
          <h2 class="mc-section-title">Propiedades por rango de precio</h2>
          <p class="mc-muted mt-1 text-xs">Distribución del catálogo inmobiliario</p>
        </div>
        <span class="mc-pill mc-pill-orange">Precios MXN</span>
      </div>
      <div class="mc-chart-box">
        <canvas id="grafRango"></canvas>
      </div>
    </section>

    <section class="mc-panel">
      <div class="mc-panel-header">
        <div>
          <h2 class="mc-section-title">Estado de las propiedades</h2>
          <p class="mc-muted mt-1 text-xs">En venta frente a vendidas</p>
        </div>
        <span class="mc-pill mc-pill-green">Actualizado</span>
      </div>
      <div class="mc-chart-box">
        <canvas id="grafEstatus"></canvas>
      </div>
    </section>

  </div>

  <!-- Gráfica de ciudades y mapa -->
  <div class="mb-5 grid gap-4 lg:grid-cols-2">

    <section class="mc-panel">
      <div class="mc-panel-header">
        <div>
          <h2 class="mc-section-title">Propiedades por ciudad</h2>
          <p class="mc-muted mt-1 text-xs">Distribución geográfica del catálogo</p>
        </div>
      </div>
      <div class="mc-chart-box" style="height:330px">
        <canvas id="grafCiudades"></canvas>
      </div>
    </section>

    <section class="mc-panel">
      <div class="mc-panel-header">
        <div>
          <h2 class="mc-section-title">Mapa de propiedades</h2>
          <p class="mc-muted mt-1 text-xs">Ubicaciones registradas en el sistema</p>
        </div>
        <span class="mc-pill mc-pill-green" id="mcContadorMapa">
          0 ubicaciones
        </span>
      </div>
      <div id="mcMapa"></div>
      <div class="flex flex-wrap gap-4 px-5 py-3 text-xs text-slate-500">
        <span>🟢 En venta</span>
        <span>🟠 Vendida</span>
        <span class="ml-auto">Coordenadas de demostración</span>
      </div>
    </section>

  </div>

  <!-- Listado y filtros -->
  <section class="mc-panel">
    <div class="mc-panel-header">
      <div>
        <h2 class="mc-section-title">Inventario de propiedades</h2>
        <p class="mc-muted mt-1 text-xs">
          Consulta las casas registradas en PostgreSQL
        </p>
      </div>

      <span id="mcTotalFiltrado" class="mc-pill mc-pill-green">
        <%= total %> propiedades
      </span>
    </div>

    <div class="grid gap-3 border-t border-slate-100 px-5 py-4 sm:grid-cols-2 lg:grid-cols-4">

      <input
        type="search"
        id="mcBusqueda"
        class="mc-field"
        placeholder="Buscar propiedad o ciudad..."
        aria-label="Buscar propiedad o ciudad"
      >

      <select id="mcFiltroCiudad" class="mc-field" aria-label="Filtrar ciudad">
        <option value="">Todas las ciudades</option>
        <% ciudades.forEach((ciudad) => { %>
          <option value="<%= ciudad %>"><%= ciudad %></option>
        <% }); %>
      </select>

      <select id="mcFiltroEstatus" class="mc-field" aria-label="Filtrar estatus">
        <option value="">Todos los estatus</option>
        <option value="venta">En venta</option>
        <option value="vendida">Vendidas</option>
      </select>

      <button type="button" id="mcLimpiar" class="mc-btn mc-btn-secondary">
        Limpiar filtros
      </button>

    </div>

    <div class="overflow-x-auto">
      <table class="mc-table">
        <thead>
          <tr>
            <th>Propiedad</th>
            <th>Ciudad</th>
            <th>Precio</th>
            <th>Recámaras / Baños</th>
            <th>Estatus</th>
          </tr>
        </thead>
        <tbody id="mcTablaCasas">
          <% casas.forEach((casa) => { %>
          <tr
            class="mc-casa"
            data-id="<%= casa.id %>"
            data-titulo="<%= casa.titulo %>"
            data-ciudad="<%= casa.ciudad %>"
            data-estatus="<%= casa.estatus %>"
            data-precio="<%= casa.precio %>"
            data-lat="<%= casa.latitud == null ? '' : casa.latitud %>"
            data-lng="<%= casa.longitud == null ? '' : casa.longitud %>"
          >
            <td>
              <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-lg bg-blue-50 text-xl text-blue-700">
                  ⌂
                </div>
                <div>
                  <div class="font-bold text-slate-800">
                    <%= casa.titulo %>
                  </div>
                  <div class="text-xs text-slate-400">
                    ID #<%= casa.id %>
                  </div>
                </div>
              </div>
            </td>
            <td>
              <div class="font-medium"><%= casa.ciudad %></div>
              <div class="text-xs text-slate-400"><%= casa.estado %></div>
            </td>
            <td class="whitespace-nowrap font-bold text-slate-800">
              <%= moneda(casa.precio) %>
            </td>
            <td class="whitespace-nowrap text-slate-600">
              <%= casa.recamaras %> rec. / <%= casa.banos %> baños
            </td>
            <td>
              <% if (casa.estatus === 'venta') { %>
                <span class="mc-pill mc-pill-green">En venta</span>
              <% } else { %>
                <span class="mc-pill mc-pill-orange">Vendida</span>
              <% } %>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
      <p id="mcSinResultados" class="mc-empty" hidden>
        No se encontraron propiedades con esos filtros.
      </p>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-2 border-t border-slate-100 px-5 py-4 text-xs text-slate-500">
      <span id="mcTextoRegistros">Mostrando <%= total %> propiedades</span>
      <span>Datos obtenidos de PostgreSQL</span>
    </div>
  </section>

  <div class="mc-footer">
    Multicasa · Panel administrativo · Información de demostración
  </div>
</div>

<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="/js/dashboard.js"></script>
