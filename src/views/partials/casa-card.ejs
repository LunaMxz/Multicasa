<%# Tarjeta de casa. Uso: include('../partials/casa-card', { casa }) %>
<% const img = casa.imagenPrincipal(); %>
<article class="overflow-hidden rounded border bg-white shadow-sm">
  <a href="/casas/<%= casa.id %>">
    <img src="<%= img ? img.miniatura : '/img/sin-foto.svg' %>" alt="<%= casa.titulo %>" width="400" height="300" loading="lazy" class="h-44 w-full object-cover">
  </a>
  <div class="space-y-1 p-3">
    <h3 class="text-sm font-bold text-brand-dark"><%= casa.titulo %></h3>
    <p class="text-lg font-bold text-accent"><%= moneda(casa.precio) %></p>
    <p class="text-xs text-slate-500"><%= casa.ciudad %>, <%= casa.estado %> · <%= casa.recamaras %> rec. · <%= casa.banos %> baños</p>
    <a href="/casas/<%= casa.id %>" class="text-xs font-semibold text-leaf hover:underline">Ver más…</a>
  </div>
</article>
